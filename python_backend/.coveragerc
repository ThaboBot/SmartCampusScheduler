[run]
source = app
omit = 
    */tests/*
    */migrations/*
    */__pycache__/*
    */conftest.py
    */main.py
branch = True

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
precision = 2
show_missing = True
fail_under = 80

[html]
directory = htmlcov

[xml]
output = coverage.xml
